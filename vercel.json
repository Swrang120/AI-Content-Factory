{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/factory",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/cron/self-heal",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/api/cron/live",
      "schedule": "25 8 * * *"
    }
  ]
}

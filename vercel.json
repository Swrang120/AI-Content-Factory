{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "remotion-bundle/**,remotion/**,node_modules/@remotion/studio/**,node_modules/remotion/**"
    }
  },
  "buildCommand": "npm run build"
}

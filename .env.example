# OpenAI / ChatGPT API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# ElevenLabs Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Make.com Research Automation
# Optional: Make webhook that receives research jobs from AI Content Factory
MAKE_RESEARCH_WEBHOOK_URL=
# Optional: protect Make callback endpoint
MAKE_CALLBACK_API_KEY=

# YouTube / Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=
YOUTUBE_REDIRECT_URI=http://localhost:3456/auth/youtube/callback
YOUTUBE_DEFAULT_PRIVACY=private

# Optional protection for the local/private API
APP_API_KEY=

# Server
PORT=3456

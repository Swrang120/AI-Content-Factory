{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,drive-library.html,styles.css,app-fixed.js,youtube-skills.js,music-library-fixed.js,live-status.js,notifications.js,assets/**,remotion-bundle/**,remotion/**,node_modules/@remotion/studio/**,node_modules/remotion/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/factory",
      "schedule": "30 3 * * *"
    }
  ],
  "buildCommand": "node --check server.js && node --check app.js && node --check app-fixed.js && node --check live-status.js && node --check music-library-fixed.js && node --check youtube-skills.js && npm run build"
}
